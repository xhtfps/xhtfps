","visibility":"公开","head_mb":43.4,"default_branch":"main"}],"drivers":[{"id":"ad7606","name":"AD7606 8 通道 16 位同步采样 ADC","vendor":"Analog Devices","interface":"串行模式（SPI3 硬件 SPI，mode 2）+ CONVST/BUSY 时序 + OS0–OS2 过采样","supply":"5 V 模拟 / 3.3 V IO（模块自带 DC-DC）","channels":8,"max_sps":200000,"status":"在役","platform":"STM32F407（HAL 库；SPI3 + 若干普通 GPIO）","source_repo":"stm32f4-projects","source_path":"电赛题目/电赛/F题_李萨如控制装置_F407/Drivers/BSP/AD7606/","source_commit":"main","notes":"F407 上唯一一份写得完整的 AD7606 驱动（原仓另有 3 份同内容副本）。已把依赖的 SPI3 一并收进来，并把 include 路径改成同目录，可直接拷贝编译。上板验证记录见 hardware/example_f407_ad7606/README.md。"},{"id":"ad9959","name":"AD9959 四通道 DDS","vendor":"Analog Devices","interface":"软件 3 线 SPI（SDIO0 单向写）+ 4 路 PS 通道选择 + IO_UPDATE 脉冲 + RESET","supply":"1.8 V 内核 / 3.3 V IO（板级需电平匹配）","channels":4,"max_sps":null,"status":"在役","platform":"STM32F4 标准外设库 + sys.h 位带宏（PEout/PFout/PBout）","source_repo":"RLC_dac_study_flash","source_path":"_03_Drive/Drive_AD9959.c","source_commit":"326cd33ebe9e07fa0319e1ca2a2a5de28205bcd1","notes":"源文件为 GBK，迁移时转 UTF-8；.h 内另有一组被注释掉的 PA/PB 旧接线，实际生效的是 PE/PF 那组。Init_AD9959 末尾会写死 4 个通道的初始频率/相位/幅度，接入新工程先删掉这段。"},{"id":"ads1256","name":"ADS1256 24 位 ΔΣ ADC","vendor":"Texas Instruments","interface":"软件 SPI（GPIOF bit-bang）+ DRDY 轮询 + PDWN 掉电控制","supply":"5 V 模拟 / 3.3 V IO","channels":8,"max_sps":30000,"status":"在役","platform":"STM32F4 标准外设库（GPIOF 复用为软件 SPI，不占用硬件 SPI 外设）","source_repo":"RLC_dac_study_flash","source_path":"_03_Drive/Drive_ADS1256.c","source_commit":"326cd33ebe9e07fa0319e1ca2a2a5de28205bcd1","notes":"DRDY 在驱动里当电平用（while(ADS1256_DRDY) 死等），没有超时保护，断线时会卡死；实际工程建议加计数器。Get_Val 的换算系数依赖外部基准电压与增益，用前先确认板上 VREF。 双器件共存方案见 hardware/PIN-CONFLICTS.md：同板时 SCLK 由 PF2 改 PF7、DOUT 由 PF4 改 PF9（只改两个宏），其余引脚不变。 硬件 SPI1 版：src/Drive_ADS1256_spi1.c + inc/Drive_ADS1256_spi1.h（CS PA4 / SCK PA5 / MISO PA6 / MOSI PA7 / DRDY PC0 / PDWN PC1，SPI mode 1，APB2/64≈1.3 MHz），接线表见 hardware/example_f407_dual_spi1，可跑满 30 kSPS。软件位拍版仍是默认（PF7/PF9）。"},{"id":"k230_link","name":"K230 ↔ ESP32-S3 视觉网关串口链路","vendor":"自研（跨板协议）","interface":"UART 921600 8N1 + 自定义帧（A5 5A / ver / type / len / seq / CRC16-CCITT）","supply":"3.3 V TTL 交叉连接（TX→RX、RX→TX、共地）","channels":1,"max_sps":null,"status":"在役","platform":"ESP32-S3（ESP-IDF，UART1）与 K230（CanMV MicroPython，UART2）","source_repo":"esp32-k230-ai","source_path":"K230+ESP32/（ESP32 侧 components/BSP/K230_LINK，K230 侧 k230/vision_protocol.py、vision_link.py）","source_commit":"main","notes":"帧类型：0x01 推理结果、0x02 心跳、0x10/0x11/0x12/0x13 JPEG 请求/分块/完成/应答、0x20 UI 动作、0x21 会话状态、0x22 转写、0x23 回答分块、0x24 助手错误、0x7F 错误。官方测试向量：type=1 seq=7 payload={\"task\":\"face\",\"count\":0} → a55a 01 01 1900 0700 7b22... 7559；type=2 seq=0 空负载 → a55a 0102 0000 0000 330f。py 版与 C 版的 CRC 结果一致，可互发。"}],"pins":[{"driver_id":"ad7606","board":"","net":"AD7606_RST","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"复位，高脉冲 ≥50 ns"},{"driver_id":"ad7606","board":"","net":"AD7606_CONVST_A","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"转换启动；A/B 在串行接线下并在一起"},{"driver_id":"ad7606","board":"","net":"AD7606_CONVST_B","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"同上，两脚同时翻转"},{"driver_id":"ad7606","board":"","net":"AD7606_OS0","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"过采样 OS0，1/2/4/…/64 倍"},{"driver_id":"ad7606","board":"","net":"AD7606_OS1","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"过采样 OS1"},{"driver_id":"ad7606","board":"","net":"AD7606_OS2","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"过采样 OS2"},{"driver_id":"ad7606","board":"","net":"AD7606_STBY","mcu_pin":"","peripheral":"","pin_name":"","direction":"out","note":"待机，正常工作时拉高"},{"driver_id":"ad7606","board":"","net":"AD7606_BUSY","mcu_pin":"","peripheral":"","pin_name":"","direction":"in","note":"转换忙；驱动先等它变高再等变低，避免把上一次的低电平稳态当成这次结果"},{"driver_id":"ad7606","board":"","net":"AD7606_FRSTDATA","mcu_pin":"","peripheral":"","pin_name":"","direction":"in","note":"首通道指示，当前驱动只配置不使用，接不接都行"},{